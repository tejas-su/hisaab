<?xml version="1.0" encoding="utf-8"?>
<!-- Text on the home-screen widget: Mukta for words, one line, ellipsised so a large font size
     never pushes text over the Add key (W5). Colours are set in code for the look. -->
<resources>
    <style name="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/mukta_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetText.Emphasized">
        <item name="android:fontFamily">@font/mukta_semibold</item>
    </style>
</resources>
